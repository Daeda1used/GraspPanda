# Publish source and installation inputs; everything else stays local.
/*
!/.github/
!/.gitattributes
!/.gitignore
!/LICENSE
!/README.md
!/docs/
!/grasppanda/
!/panda
!/pyproject.toml
!/uv.lock

/.github/**
!/.github/workflows/
!/.github/workflows/ci.yml
/docs/*
!/docs/DOWNLOADS.md
!/docs/INSTALL.md
!/docs/METHODS.md
!/docs/MODULES.md
!/docs/REFERENCE.md
!/docs/THIRD_PARTY.md
!/docs/USAGE.md
!/docs/assets/
/docs/assets/*
!/docs/assets/overview.svg

# Runtime source plus explicitly registered templates, pins and build resources.
/grasppanda/**
!/grasppanda/**/
!/grasppanda/**/*.py
!/grasppanda/runtime/bootstrap.sh
!/grasppanda/resources/checkpoints.json
!/grasppanda/resources/component_sources.lock.json
!/grasppanda/resources/component_weights.json
!/grasppanda/resources/examples.json
!/grasppanda/resources/flash3d/CMakeLists.txt
!/grasppanda/resources/flash3d/attention-backward.patch
!/grasppanda/resources/flash3d/native-runtime.patch
!/grasppanda/resources/flash3d/te-cuda118.patch
!/grasppanda/resources/flash3d/toolchain.lock.json
!/grasppanda/resources/gpg_binding.cpp
!/grasppanda/resources/masked_fps.cpp
!/grasppanda/resources/masked_fps_kernel.cu
!/grasppanda/resources/methods.json
!/grasppanda/resources/native_sources.lock.json
!/grasppanda/resources/patches/LauncherTemplate/linux.patch
!/grasppanda/resources/patches/centergrasp/pipeline.patch
!/grasppanda/resources/patches/centergrasp/python311.patch
!/grasppanda/resources/patches/gfla_source/pipeline.patch
!/grasppanda/resources/patches/scikit-geometry/pybind11-property-lifetime.patch
!/grasppanda/resources/patches/spgrasp/continuous-targets.patch
!/grasppanda/resources/patches/swin3d/native-runtime.patch
!/grasppanda/resources/patches/sp2t/native-runtime.patch
!/grasppanda/resources/upstreams.lock.json

# Private diagnostics and generated Python files are never product source.
**/tests/
**/reports/
**/benchmarks/
**/probes/
**/logs/
**/outputs/
**/checkpoints/
**/environments/
**/upstream/
**/data/
**/datasets/
**/build/
**/dist/
**/tmp/
**/temp/
**/__pycache__/
**/.*
**/test_*.py
**/*_test.py
**/probe_*.py
**/benchmark_*.py
**/*handoff*
**/*.local.*
!/.gitattributes
!/.gitignore
!/.github/
!/.github/workflows/
!/.github/workflows/ci.yml
