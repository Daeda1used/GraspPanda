# Only product directories and required root files belong in the repository.
/*
!/.github/
!/.gitattributes
!/.gitignore
!/GraspNet-1B/
!/LICENSE
!/README.md
!/docs/
!/grasppanda/
!/panda
!/pyproject.toml
!/uv.lock

# Keep drafts and local notes out of the published guides and automation.
/docs/*
!/docs/DOWNLOADS.md
!/docs/EXTENDING.md
!/docs/GTG2.md
!/docs/INSTALL.md
!/docs/METHODS.md
!/docs/MODULES.md
!/docs/THIRD_PARTY.md
!/docs/USAGE.md
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/ci.yml
/grasppanda/**/*.md
/grasppanda/**/.*

# The dataset entry contains guides and templates, never local dataset contents.
/GraspNet-1B/*
!/GraspNet-1B/README.md
!/GraspNet-1B/examples.yaml

# Generated files and credentials remain local, including inside source folders.
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/*.egg-info/
**/tests/
**/reports/
**/benchmarks/
